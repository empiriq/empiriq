// Alloy reads the output of every container of the compose project "empiriq"
// through the Docker socket and sends it to Loki. The services write to
// stdout as usual; they know nothing about Loki.

discovery.docker "stack" {
  host = "unix:///var/run/docker.sock"
  filter {
    name   = "label"
    values = ["com.docker.compose.project=empiriq"]
  }
}

// Labels: the compose service and the container.
discovery.relabel "stack" {
  targets = []

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
}

loki.source.docker "stack" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.docker.stack.targets
  relabel_rules = discovery.relabel.stack.rules
  forward_to    = [loki.process.level.receiver]
}

// The level as a label. Lines without a level have no label.
loki.process "level" {
  // Postgres: "<time> [<pid>] ERROR:  ...": a level in capitals, a colon and
  // two spaces. DETAIL, HINT, CONTEXT, STATEMENT and QUERY lines continue the
  // line before, so join them: an error and its statement are one entry.
  stage.match {
    selector = "{service=\"empiriq\"}"

    stage.multiline {
      firstline     = "(^|\\s)(DEBUG[1-5]|LOG|INFO|NOTICE|WARNING|ERROR|FATAL|PANIC):  "
      max_wait_time = "3s"
    }
    stage.regex {
      expression = "(^|\\s)(?P<level>DEBUG[1-5]|LOG|INFO|NOTICE|WARNING|ERROR|FATAL|PANIC):  "
    }
    // The levels of the other services: debug, info, warn, error.
    stage.template {
      source   = "level"
      template = "{{ if eq .Value \"DEBUG1\" \"DEBUG2\" \"DEBUG3\" \"DEBUG4\" \"DEBUG5\" }}debug{{ else if eq .Value \"WARNING\" }}warn{{ else if eq .Value \"ERROR\" \"FATAL\" \"PANIC\" }}error{{ else }}info{{ end }}"
    }
  }

  // Other services: "level":"INFO" (JSON of the Go services) or level=info
  // (logfmt of Grafana, Alloy and Loki).
  stage.match {
    selector = "{service!=\"empiriq\"}"

    stage.regex {
      expression = "(?i)\"?level\"?\\s*[=:]\\s*\"?(?P<level>[a-z]+)"
    }
    stage.template {
      source   = "level"
      template = "{{ ToLower .Value }}"
    }
  }

  stage.labels {
    values = { level = "" }
  }
  forward_to = [loki.write.loki.receiver]
}

loki.write "loki" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
