# Grafana. Any setting of grafana.ini can be set as GF_<SECTION>_<KEY>;
# put settings of your installation into board.local.env.
# The admin password is used only when Grafana starts the first time.
GF_SECURITY_ADMIN_USER=${BOARD_ADMIN_USER}
GF_SECURITY_ADMIN_PASSWORD=${BOARD_ADMIN_PASSWORD}
# The log store, for the page Logs.
EMPIRIQ_LOG_STORE_URL=http://log-store:3100
