#!/usr/bin/env php
<?php

use App\Kernel;
use Empiriq\Contracts\Entrypoint;

require dirname(__DIR__, 2) . '/vendor/autoload.php';

$kernel = new Kernel('back', true);
$kernel->boot();

/** @var Entrypoint $entrypoint */
$entrypoint = $kernel->getContainer()->get(Entrypoint::class);
$entrypoint->run();
