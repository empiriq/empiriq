{
    "name": "empiriq/binance-manager",
    "minimum-stability": "alpha",
    "prefer-stable": true,
    "description": "Framework designed for implementing your trading strategies",
    "keywords": ["empiriq-bundle", "binance", "binance-api", "binance-streams", "binance-websockets"],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Mikhail Gerasimov",
            "email": "migerasimoff@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.4",
        "psr/event-dispatcher": "^1.0",
        "symfony/polyfill-php84": "^1.32",
        "symfony/serializer-pack": "^1.3",
        "symfony/yaml": "^7.3",
        "symfony/event-dispatcher": "^7.3",
        "monolog/monolog": "^3.9",
        "symfony/cache": "^7.3",
        "react/event-loop": "^1.5",
        "react/async": "^4.3",
        "react/stream": "^1.4",
        "bramus/monolog-colored-line-formatter": "^3.1",
        "plesk/stdio-react": "^2.6",
        "symfony/dependency-injection": "^7.3",
        "symfony/config": "^7.3",
        "symfony/http-kernel": "^7.3",
        "symfony/monolog-bundle": "^3.10",
        "symfony/framework-bundle": "^7.3",
        "symfony/runtime": "^7.3"
    },
    "autoload": {
         "psr-4": { "Empiriq\\BinanceManager\\": "" },
         "exclude-from-classmap": [ "/Tests/" ]
    }
}
