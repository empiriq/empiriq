{
    "name": "empiriq/binance-paper-trade-bundle",
    "minimum-stability": "alpha",
    "prefer-stable": true,
    "description": "Framework designed for implementing your trading strategies",
    "keywords": ["empiriq-exchange-connector", "empiriq-bundle", "paper-trade", "binance", "binance-api", "binance-streams", "binance-websockets"],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Mikhail Gerasimov",
            "email": "migerasimoff@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.4"
    },
    "autoload": {
        "psr-4": { "Empiriq\\BinancePaperTradeBundle\\": "" },
        "exclude-from-classmap": [ "/Tests/" ]
    }
}
