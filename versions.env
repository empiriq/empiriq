# Versions of the images that the stack builds and runs.
#   dev      built from the repositories next to this one (SOURCE=local)
#   vX.Y.Z   a git tag of the repository (SOURCE=git), or an image of a registry
# A set of versions that work together is a release of the stack.
DATABASE_VERSION=dev
BINANCE_BACKFILLER_VERSION=dev
BINANCE_FEEDER_VERSION=dev
CONSOLE_VERSION=dev
