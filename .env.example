# Copy to .env and change what you need. All values here are the defaults.

# Paths of the repositories
EMPIRIQ_DIR=../empiriq
BINANCE_BACKFILLER_DIR=../binance-backfiller
CONSOLE_DIR=../console

# Database
EMPIRIQ_PG_PORT=1792
EMPIRIQ_DB_NAME=empiriq
EMPIRIQ_DB_ADMIN_USER=empiriq
EMPIRIQ_DB_ADMIN_PASSWORD=empiriq

# Logins of the services
CONSOLE_DB_USER=empiriq_console
CONSOLE_DB_PASSWORD=console
BACKFILLER_DB_USER=empiriq_backfiller
BACKFILLER_DB_PASSWORD=backfiller

# Console (Grafana)
CONSOLE_PORT=3000
CONSOLE_ADMIN_USER=admin
CONSOLE_ADMIN_PASSWORD=admin
