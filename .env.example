# Copy to .env and change what you need. All values here are the defaults.

# Sources of the images (make build): local or git
SOURCE=local
# For SOURCE=git: the GitHub organization of the repositories
GITHUB_ORG=empiriq
# Prefix of the image names, for example ghcr.io/<org>/. Empty: local images.
REGISTRY=
# never: use only local images. missing: pull them from REGISTRY if missing.
PULL_POLICY=never

# Paths of the repositories, for SOURCE=local
DATABASE_DIR=../database
BINANCE_BACKFILLER_DIR=../binance-backfiller
BINANCE_FEEDER_DIR=../binance-feeder
CONSOLE_DIR=../console

# Database. All services log in as this owner.
DATABASE_PORT=1792
POSTGRES_DB=empiriq
POSTGRES_USER=empiriq
POSTGRES_PASSWORD=empiriq

# Console (Grafana)
CONSOLE_PORT=3000
CONSOLE_ADMIN_USER=admin
CONSOLE_ADMIN_PASSWORD=admin

# Logs: how long Loki keeps them
LOKI_RETENTION=168h
