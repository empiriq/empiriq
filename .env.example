# Settings of the stack. Copy to .env and change what you need. All values
# here are the defaults: compose.yaml has none of its own. make creates .env
# from this file if it is missing.
#
# Names: IMAGE_* for all images, <SERVICE>_* for one service (its name in
# compose.yaml). env/ passes them to the containers under the names that the
# images expect.

# Images. IMAGE_SOURCE: where make build takes the code, local (the
# repositories next to this one) or git (GitHub, the default branch).
IMAGE_SOURCE=local
# For IMAGE_SOURCE=git: the GitHub organization of the repositories.
IMAGE_GITHUB_ORG=empiriq
# Prefix of the image names, for example ghcr.io/<org>/. Empty: local images.
IMAGE_REGISTRY=
# never: use only local images. missing: pull them from IMAGE_REGISTRY.
IMAGE_PULL_POLICY=never

# Paths of the repositories, for IMAGE_SOURCE=local.
DATABASE_DIR=../database
BINANCE_BACKFILLER_DIR=../binance-backfiller
BINANCE_FEEDER_DIR=../binance-feeder
BOARD_DIR=../board

# database: its port on this computer, the database and its owner. All
# services log in as this owner.
DATABASE_PORT=1792
DATABASE_NAME=empiriq
DATABASE_USER=empiriq
DATABASE_PASSWORD=empiriq

# board: its port on this computer, and the first Grafana user.
BOARD_PORT=3000
BOARD_ADMIN_USER=admin
BOARD_ADMIN_PASSWORD=admin

# log-store: how long Loki keeps the logs.
LOG_STORE_RETENTION=168h
