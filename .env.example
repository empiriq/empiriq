# Copy to .env and change what you need. All values here are the defaults.

# Paths of the repositories
EMPIRIQ_DIR=../empiriq
BINANCE_BACKFILLER_DIR=../binance-backfiller
BINANCE_FEEDER_DIR=../binance-feeder
CONSOLE_DIR=../console

# Database. All services log in as this owner.
EMPIRIQ_PG_PORT=1792
POSTGRES_DB=empiriq
POSTGRES_USER=empiriq
POSTGRES_PASSWORD=empiriq

# Console (Grafana)
CONSOLE_PORT=3000
CONSOLE_ADMIN_USER=admin
CONSOLE_ADMIN_PASSWORD=admin

# Logs: how long Loki keeps them
LOKI_RETENTION=168h
